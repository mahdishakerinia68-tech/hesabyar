rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validUserFields() {
      return request.resource.data.keys().hasOnly([
        'appVersion', 'updatedAt', 'lastRestoreAt'
      ]);
    }

    function validRecord() {
      return request.resource.data.keys().hasOnly([
        'id', 'type', 'record', 'revision', 'updatedAt', 'updatedBy', 'deviceId', 'deleted'
      ])
      && request.resource.data.id is string
      && request.resource.data.type is string
      && request.resource.data.record is map
      && request.resource.data.revision is int
      && request.resource.data.revision >= 0
      && request.resource.data.updatedAt is string
      && request.resource.data.updatedBy is string
      && request.resource.data.deviceId is string
      && request.resource.data.deleted is bool
      && request.resource.data.size() < 900000;
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId) && validUserFields();
      allow delete: if signedInAs(userId);

      match /records/{recordId} {
        allow read: if signedInAs(userId);
        allow create, update: if signedInAs(userId) && validRecord() && request.resource.data.id == recordId;
        allow delete: if signedInAs(userId);
      }

      match /devices/{deviceId} {
        allow read: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && request.resource.data.keys().hasOnly(['deviceId', 'lastSeen', 'updatedAt', 'appVersion'])
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId == deviceId
          && request.resource.data.lastSeen is string
          && request.resource.data.updatedAt is string
          && request.resource.data.appVersion is string
          && request.resource.data.size() < 10000;
        allow delete: if signedInAs(userId);
      }
    }
  }
}
